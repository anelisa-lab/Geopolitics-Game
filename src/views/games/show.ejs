<link rel="stylesheet" href="/css/game.css">

<div id="game" class="game" data-game-id="<%= game.id %>">
  <header class="game-top">
    <div class="game-heading">
      <a href="<%= game.isOwner ? '/dashboard' : '/games' %>" class="back-link">← <%= game.isOwner ? 'My games' : 'Browse games' %></a>
      <h1><%= game.title %></h1>
      <div class="game-meta" id="game-meta">Round <%= game.round %> · <%= game.statusLabel %></div>
    </div>
    <button type="button" id="share-btn" class="btn btn-secondary">🔗 Share link</button>
  </header>

  <div id="banner" class="game-banner" hidden></div>

  <div class="game-layout">
    <section class="board-area" aria-label="Board">
      <div id="actions" class="actions" aria-live="polite" hidden></div>
      <div id="board" class="board-grid">
        <% game.territories.forEach((territory) => { %>
          <div class="country-card" style="--owner: <%= territory.ownerColor %>">
            <div class="card-head">
              <img src="https://flagcdn.com/w80/<%= territory.iso2.toLowerCase() %>.png" alt="" width="32" height="22">
              <span class="card-name"><%= territory.name %></span>
            </div>
            <div class="card-soldiers"><%= territory.soldiers %></div>
            <div class="card-owner"><%= territory.ownerName %> · value <%= territory.soldierValue %></div>
          </div>
        <% }) %>
      </div>
    </section>

    <aside class="panel players-panel" aria-label="Players">
      <h2>Players</h2>
      <ol id="players" class="players"></ol>
    </aside>

    <aside class="panel feed-panel" aria-label="Live feed">
      <h2>Live feed</h2>
      <ol id="feed" class="feed"></ol>
    </aside>
  </div>
</div>

<dialog id="dialog" class="game-dialog" aria-live="polite"></dialog>
<div id="toasts" class="toasts" aria-live="polite"></div>

<noscript><p class="banner">Turn on JavaScript to play. You can still see the board above.</p></noscript>

<script type="application/json" id="initial-state"><%- initialStateJson %></script>
<script type="module" src="/js/game/main.js"></script>
