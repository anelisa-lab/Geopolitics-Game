<section>
  <div class="page-head">
    <h1>My games</h1>
    <a href="/games/new" class="btn">+ New game</a>
  </div>

  <%- include('partials/gameFilters') %>

  <% if (items.length) { %>
    <%- include('partials/gameTable', { showOwner: false }) %>
    <%- include('partials/pagination') %>
  <% } else if (isFiltered) { %>
    <p class="empty">No games match your search. <a href="/dashboard">Clear filters</a></p>
  <% } else { %>
    <p class="empty">You haven't started a game yet. <a href="/games/new">Start your first one</a> and conquer the world.</p>
  <% } %>
</section>