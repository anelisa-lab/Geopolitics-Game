<%
  // Highlights the page you're on
  const navLink = (href, label, extraClass = '') => {
    const active = currentPath === href;
    return `<a href="${href}" class="${[extraClass, active ? 'active' : ''].join(' ').trim()}"${active ? ' aria-current="page"' : ''}>${label}</a>`;
  };
%>
<nav class="navbar">
  <a href="/" class="brand">🌍 Geopolitics Game</a>
  <ul>
    <li><%- navLink('/games', 'Browse games') %></li>
    <% if (currentUser) { %>
      <li><%- navLink('/dashboard', 'My games') %></li>
      <li><%- navLink('/games/new', 'New game') %></li>
      <li class="nav-user">👤 <%= currentUser.username %></li>
      <li>
        <form method="POST" action="/logout" class="inline-form">
          <button type="submit" class="link-button">Log out</button>
        </form>
      </li>
    <% } else { %>
      <li><%- navLink('/login', 'Log in') %></li>
      <li><%- navLink('/signup', 'Sign up', 'btn') %></li>
    <% } %>
  </ul>
</nav>
